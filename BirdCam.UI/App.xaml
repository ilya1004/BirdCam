<Application x:Class="BirdCam.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BirdCam.UI.ViewModels"
             xmlns:views="clr-namespace:BirdCam.UI.Views"
             xmlns:conv="clr-namespace:BirdCam.UI.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />

            <DataTemplate DataType="{x:Type vm:LiveViewModel}">
                <views:LiveView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GalleryViewModel}">
                <views:GalleryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DatasetViewModel}">
                <views:DatasetView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrainingViewModel}">
                <views:TrainingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
