<UserControl x:Class="BirdCam.UI.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Галерея" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Summary}"
                       Style="{StaticResource Muted}"
                       VerticalAlignment="Center"
                       Margin="16,4,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Content="Отправить" Command="{Binding SendCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource AccentButton}" />
            <Button Content="Открыть" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" />
            <Button Content="Папка файла" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding Selected}" />
            <Button Content="Папка снимков" Command="{Binding OpenMediaFolderCommand}" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource DangerButton}" />
        </WrapPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource CardItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="238" Padding="10">
                        <StackPanel>
                            <Border CornerRadius="8" Background="#0B0E13" Height="132" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PreviewPath}" Stretch="UniformToFill" />
                                    <TextBlock Text="нет превью"
                                               Style="{StaticResource Muted}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding PreviewPath, Converter={StaticResource NullToVis}}" />
                                    <Border Background="#B0000000"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="8">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,9,0,2" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,0" />
                            <TextBlock Text="✓ отправлено в Telegram"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       Margin="2,5,0,0"
                                       Visibility="{Binding SentToTelegram, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

