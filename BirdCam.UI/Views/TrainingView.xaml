<UserControl x:Class="BirdCam.UI.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Обучение вида" Style="{StaticResource H1}" />
                    <Border Background="#1B3A2E"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,3"
                            Margin="14,4,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="YOLO · ultralytics" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Дообучение детектора на вашем датасете: синица, кропы и YOLO-разметка уже собираются автоматически."
                           Style="{StaticResource Muted}"
                           Margin="0,5,0,0" />
                <TextBlock Text="{Binding ActiveModelText}"
                           Style="{StaticResource Muted}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="424" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,10,0">
                <StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1 · Данные" Style="{StaticResource H2}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="КАДРОВ" Style="{StaticResource Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding ImageCount}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="РАМОК" Style="{StaticResource Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding BoxCount}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DatasetSummary}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DateRangeText}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ClassesSummary}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DatasetDetails}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="54" />

                            <TextBlock Text="Названия классов (по одному на строку)" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                            <TextBox Style="{StaticResource EditorBox}"
                                     Text="{Binding ClassNames, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="48"
                                     MaxHeight="90" />
                            <TextBlock Text="Для текущей разметки достаточно одной строки: синица. Если позже появятся другие виды, добавьте их строками ниже."
                                       Style="{StaticResource Muted}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Валидация" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBox Width="54" Text="{Binding ValidationPercent, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Text="последние кадры по времени" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Проверить данные" Command="{Binding RefreshCommand}" />
                                <Button Content="Подготовить сплит" Command="{Binding PrepareSplitCommand}" />
                                <Button Content="Папка датасета" Command="{Binding OpenDatasetFolderCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SplitSummary}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2 · Окружение" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding EnvironmentSummary}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnvironmentReady}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding EnvironmentDetail}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="Python" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
                                <Button Grid.Column="1" Content="…" Command="{Binding PickPythonCommand}" Margin="6,0,0,0" Padding="10,6" />
                                <Button Grid.Column="2" Content="Проверить" Command="{Binding CheckEnvironmentCommand}" Margin="6,0,0,0" Padding="10,6" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{Binding PythonVersion, StringFormat='Python {0}'}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding TorchVersion, StringFormat='torch {0}'}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding UltralyticsVersion, StringFormat='ultralytics {0}'}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <Button Content="Как установить Python"
                                    Command="{Binding ShowPythonHelpCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3 · Параметры" Style="{StaticResource H2}" />

                            <TextBlock Text="Базовая модель (.pt)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}" />
                            <TextBlock Text="Начинайте с yolo26n: на CPU одна эпоха ≈ 40–60 секунд. Для 40 эпох это около 40 минут."
                                       Style="{StaticResource Muted}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Эпох" Style="{StaticResource Muted}" />
                                    <TextBox Text="{Binding Epochs, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Размер входа" Style="{StaticResource Muted}" />
                                    <TextBox Text="{Binding ImageSize, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Batch" Style="{StaticResource Muted}" />
                                    <TextBox Text="{Binding Batch, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Workers" Style="{StaticResource Muted}" />
                                    <TextBox Text="{Binding Workers, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Устройство" Style="{StaticResource Muted}" />
                                    <TextBox Text="{Binding Device, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Устройство: cpu или 0 (GPU через CUDA/ROCm). При наличии GPU приложение выбирает 0 автоматически."
                                       Style="{StaticResource Muted}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="4 · Запуск" Style="{StaticResource H2}" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Начать обучение"
                                        Command="{Binding StartTrainingCommand}"
                                        Style="{StaticResource AccentButton}" />
                                <Button Content="Остановить"
                                        Command="{Binding StopTrainingCommand}"
                                        Style="{StaticResource DangerButton}" />
                                <Button Content="Копировать команду" Command="{Binding CopyTrainingCommand}" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding EtaText}"
                                           Style="{StaticResource Muted}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                         Minimum="0"
                                         Maximum="100" />
                            <TextBlock Text="{Binding MetricsText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Обучение идёт отдельным процессом: поток и детекция продолжают работать. При закрытии приложения процесс будет остановлен."
                                       Style="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Журнал обучения" Style="{StaticResource H2}" Margin="0" />
                                <TextBlock Text="вывод Python и метрики"
                                           Style="{StaticResource Muted}"
                                           VerticalAlignment="Center"
                                           Margin="10,1,0,0" />
                            </StackPanel>
                            <Button Content="Открыть папку"
                                    Command="{Binding OpenTrainingFolderCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="10,6" />
                        </Grid>
                        <TextBox Grid.Row="1"
                                 Height="430"
                                 Style="{StaticResource LogBox}"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 TextChanged="OnLogTextChanged" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Результат" Style="{StaticResource H2}" Margin="0" />
                            <Button Content="Папка запуска"
                                    Command="{Binding OpenRunFolderCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="10,6" />
                        </Grid>

                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <Border Background="#0B0E13"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <TextBlock Text="{Binding ResultText}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11.5"
                                           Foreground="#BFE9D3"
                                           TextWrapping="Wrap" />
                            </Border>
                            <WrapPanel>
                                <Button Content="Установить и использовать"
                                        Command="{Binding InstallModelCommand}"
                                        Style="{StaticResource AccentButton}" />
                                <Button Content="Открыть папку запуска" Command="{Binding OpenRunFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="Здесь появится best.onnx после обучения. Установка скопирует модель в папку models и переключит детектор на неё."
                                   Style="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Выбрать готовый ONNX…"
                                    Command="{Binding InstallFromFileCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
