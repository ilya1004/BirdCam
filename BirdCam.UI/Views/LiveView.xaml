<UserControl x:Class="BirdCam.UI.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BirdCam.UI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,14">
            <Button Content="▶ Запустить" Command="{Binding StartCommand}" Style="{StaticResource AccentButton}" />
            <Button Content="■ Стоп" Command="{Binding StopCommand}" />
            <Button Content="Снимок" Command="{Binding SnapshotCommand}" />
            <Button Content="Клип" Command="{Binding RecordClipCommand}" />
            <ToggleButton Content="Автодетекция" IsChecked="{Binding IsDetectionEnabled}" />
            <Button Content="В датасет" Command="{Binding AddToDatasetCommand}" />
            <Button Content="В Telegram" Command="{Binding SendLastCommand}" />
        </WrapPanel>

        <Border Grid.Row="1" Background="#05070A" CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding Frame}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <controls:DetectionOverlay Items="{Binding Detections}"
                                           SourceWidth="{Binding SourceWidth}"
                                           SourceHeight="{Binding SourceHeight}"
                                           IsHitTestVisible="False" />

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Background="#99000000"
                        CornerRadius="8"
                        Padding="10,5">
                    <TextBlock Text="{Binding ResolutionText}" Foreground="White" FontSize="12" />
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Background="#99000000"
                        CornerRadius="8"
                        Padding="10,5">
                    <TextBlock Text="{Binding FpsText}" Foreground="#9FE8C0" FontSize="12" />
                </Border>

                <TextBlock Text="Поток не запущен — нажмите «Запустить»"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="ДЕТЕКТОР" Style="{StaticResource Muted}" FontSize="10" />
                    <TextBlock Text="{Binding DetectionStatus}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="ПОСЛЕДНЕЕ СОБЫТИЕ" Style="{StaticResource Muted}" FontSize="10" />
                    <TextBlock Text="{Binding LastEventText}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="ПТИЦ СЕГОДНЯ" Style="{StaticResource Muted}" FontSize="10" />
                    <TextBlock Text="{Binding TodayBirds}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="8" Width="108" Height="72">
                <Grid>
                    <Image Source="{Binding LastSnapshot}" Stretch="UniformToFill" />
                    <TextBlock Text="нет кадра"
                               Style="{StaticResource Muted}"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding LastSnapshot, Converter={StaticResource NullToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>



